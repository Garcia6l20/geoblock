#!/usr/bin/python3 -I
"""Entry point; the library directory is fixed at install time (see Makefile)."""
import os
import sys

LIBDIR = "/usr/local/lib/geoblock"
if not os.path.isdir(os.path.join(LIBDIR, "geoblock")):
    # Running from a source checkout.
    LIBDIR = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
sys.path.insert(0, LIBDIR)

from geoblock.cli import main  # noqa: E402

sys.exit(main())
